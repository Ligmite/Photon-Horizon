+
+    /// The LabPBR normal and specular atlases (resource packs' `_n`/`_s` maps) over this
+    /// atlas's grid, so a pack's `normals` and `specular` samplers see the same cells as its
+    /// block atlas. Keeps the stand-ins when the maps are not the atlas's sprite size (a layer
+    /// would not fit a cell) or the grid is larger than the device allows.
+    pub fn with_labpbr(
+        mut self,
+        device: &wgpu::Device,
+        encoder: &mut wgpu::CommandEncoder,
+        maps: &[wgpu::Texture; 2],
+    ) -> Self {
+        let sprite = self.sprite;
+        if maps
+            .iter()
+            .any(|m| m.width() != sprite || m.height() != sprite)
+        {
+            return self;
+        }
+        let levels = (self.texture.mip_level_count().min(sprite.ilog2() + 1))
+            .min(maps[0].mip_level_count())
+            .min(maps[1].mip_level_count());
+        let max = device.limits().max_texture_dimension_2d;
+        if self.columns * sprite > max || self.rows * sprite > max {
+            return self;
+        }
+        let mut views: [Option<wgpu::TextureView>; 2] = [None, None];
+        for (k, map) in maps.iter().enumerate() {
+            let texture = device.create_texture(&wgpu::TextureDescriptor {
+                label: Some("Shader pack LabPBR atlas"),
+                size: wgpu::Extent3d {
+                    width: self.columns * sprite,
+                    height: self.rows * sprite,
+                    depth_or_array_layers: 1,
+                },
+                mip_level_count: levels,
+                sample_count: 1,
+                dimension: wgpu::TextureDimension::D2,
+                format: wgpu::TextureFormat::Rgba8Unorm,
+                usage: wgpu::TextureUsages::TEXTURE_BINDING
+                    | wgpu::TextureUsages::COPY_DST
+                    | wgpu::TextureUsages::COPY_SRC,
+                view_formats: &[],
+            });
+            for layer in 0..self.layers {
+                let (column, row) = (layer % self.columns, layer / self.columns);
+                for level in 0..levels {
+                    let edge = (sprite >> level).max(1);
+                    encoder.copy_texture_to_texture(
+                        wgpu::TexelCopyTextureInfo {
+                            texture: map,
+                            mip_level: level,
+                            origin: wgpu::Origin3d {
+                                x: 0,
+                                y: 0,
+                                z: layer,
+                            },
+                            aspect: wgpu::TextureAspect::All,
+                        },
+                        wgpu::TexelCopyTextureInfo {
+                            texture: &texture,
+                            mip_level: level,
+                            origin: wgpu::Origin3d {
+                                x: column * edge,
+                                y: row * edge,
+                                z: 0,
+                            },
+                            aspect: wgpu::TextureAspect::All,
+                        },
+                        wgpu::Extent3d {
+                            width: edge,
+                            height: edge,
+                            depth_or_array_layers: 1,
+                        },
+                    );
+                }
+            }
+            views[k] = Some(texture.create_view(&Default::default()));
+        }
+        self.labpbr = match views {
+            [Some(normals), Some(specular)] => Some([normals, specular]),
+            _ => None,
+        };
+        self
+    }
+
+    /// The LabPBR normal and specular atlases (`with_labpbr`), when the maps were usable.
+    pub fn labpbr(&self) -> Option<[wgpu::TextureView; 2]> {
+        self.labpbr.clone()
     }
 
